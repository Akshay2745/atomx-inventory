# ============ InventoryX settings (copy this file to .env and fill it in) ============

# Port the server listens on
PORT=3000

# The address people use to open InventoryX (used for links inside emails)
APP_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://inventoryx:CHANGE_ME@localhost:5432/inventoryx

# Set to true when running behind an HTTPS proxy (Nginx, a load balancer, or a hosting platform)
TRUST_PROXY=false

# Company email (leave commented out to use the free test inbox)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=inventory@yourcompany.com
# SMTP_PASS=CHANGE_ME
# MAIL_FROM=InventoryX <inventory@yourcompany.com>